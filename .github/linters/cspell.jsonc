// cspell project dictionary for MegaLinter's SPELL_CSPELL (see
// SPELL_CSPELL_CONFIG_FILE in mega-linter.yml). "#1234" refers to the pull
// request of this repository that introduced the entry.
{
  // "$schema", "version" and "language" came with the original file (#3857),
  // which gives no reason for them.
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  // Why (#3857, fixes #3843): cspell flagged 3,215 instances across 382
  // legitimate technical terms - project-specific jargon, tool names, shell
  // keywords and third-party proper nouns - as unknown words. None are typos.
  // The groups follow the categories named in #3857; the last group holds the
  // terms that PR lists without a category.
  "words": [
    // OpenTelemetry
    "otelapi",
    "otelcol",
    "otlp",
    "spankind",
    "tracecontext",
    "traceparent",
    "tracestate",
    // Shell
    "busybox",
    "elif",
    "esac",
    "histexpand",
    "mkfifo",
    "nohup",
    "pipefail",
    "shebang",
    "shopt",
    "subshell",
    "ulimit",
    "umask",
    // Azure
    "eastus",
    "northcentralus",
    "scaleset",
    "virtualmachines",
    "westcentralus",
    "westus",
    // TLS and certificate authorities
    "digicert",
    "geotrust",
    "globalsign",
    "identrust",
    "ocsp",
    "sectigo",
    "symantec",
    "thawte",
    "usertrust",
    "verisign",
    // Tooling
    "debconf",
    "dpkg",
    "ghcup",
    "gradlew",
    "javaagent",
    "javac",
    "npmjs",
    "pipx",
    "pypi",
    "snapcraft",
    "temurin",
    "venv",
    "zypper",
    // Project names
    "autoapprove",
    "autobackport",
    "autofix",
    "autotriage",
    "autoversion",
    "philbot",
    "plengauer",
    "thoth",
    // Debian packaging
    "confdef",
    "confold",
    "dirmngr",
    "gpgconf",
    "gpgv",
    "keyboxd",
    "keyrings",
    "postinst",
    "prerm",
    // Dev and CI tools
    "cicd",
    "grpc",
    "jsonl",
    "megalinter",
    "protobuf",
    "renovatebot",
    "shellcheck",
    "strace",
    "zizmor",
    // Networking
    "ncat",
    "netcat",
    "squid",
    // Other terms of the same dictionary, no category given in #3857
    "aarch64",
    "almquist",
    "amd64",
    "anthropic",
    "apiguardian",
    "appstreamcli",
    "argjson",
    "autorerun",
    "byok",
    "bytebuddy",
    "checksuite",
    "classpath",
    "cmdarray",
    "cmdline",
    "codex",
    "confmodule",
    "datasource",
    "dbus",
    "distro",
    "dotnet",
    "execve",
    "exporter",
    "fedora",
    "findutils",
    "foojay",
    "functools",
    "gawk",
    "gdbus",
    "gemma",
    "getopt",
    "getopts",
    "ghcr",
    "googleapis",
    "gpghome",
    "gpgvcommand",
    "gradle",
    "gradlehttppropagationagent",
    "guava",
    "haiku",
    "injected",
    "instrumentations",
    "javax",
    "jsonc",
    "jspecify",
    "junit",
    "keyring",
    "kvps",
    "kwargs",
    "launchpad",
    "libinjecthttpheader",
    "lineno",
    "macos",
    "maven",
    "moreutils",
    "noarch",
    "noninteractive",
    "noop",
    "opensuse",
    "packagecloud",
    "pdksh",
    "posh",
    "printenv",
    "propagator",
    "pubkey",
    "readlink",
    "rhel",
    "rootcontextagent",
    "rscd",
    "rsct",
    "runpy",
    "safeoutputs",
    "skoid",
    "sktid",
    "sonnet",
    "stderr",
    "stdin",
    "stdout",
    "subprocesses",
    "tmpdir",
    "traceloop",
    "unalias",
    "varname",
    "varvalue",
    "xargs",
    "yash"
  ],
  // Why: no reason is given in #3857, which added both entries. No *.lock
  // files are tracked at the moment. The generated *.lock.yml files are not
  // listed because MegaLinter's FILTER_REGEX_EXCLUDE already keeps them away
  // from cspell, which runs with a file list.
  "ignorePaths": [
    "*.lock",
    ".git/**"
  ]
}
