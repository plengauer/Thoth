#!/bin/sh -e
rm -rf /opt/opentelemetry_bash 1>/dev/null 2>/dev/null || true # clean the old install directory
if [ "$1" = 'abort-configure' ] || [ "$1" = 'abort-upgrade' ] || [ "$1" = 'abort-remove' ] || [ "$1" = 'abort-deconfigure' ]; then
  true
elif [ "$1" = 'configure' ] || [ "$1" = 'triggered' ] || [ "$1" = 'reconfigure' ]; then
  export PATH=/usr/local/bin:"$PATH"
  hardlink_or_copy() { cp -a -l "$1" "$2" 2>/dev/null || { rm -rf "$2" && cp -r "$1" "$2"; }; }
  my_pip() {
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export PIP_NO_INPUT=1
    if [ -n "${OTEL_SHELL_CONFIG_INSTALL_PIP_FIND_LINKS:-}" ] && [ -d "${OTEL_SHELL_CONFIG_INSTALL_PIP_FIND_LINKS:-}" ]; then
      "$@" --no-index --find-links "$OTEL_SHELL_CONFIG_INSTALL_PIP_FIND_LINKS" && return 0
    fi
    "$@"
  }
  # extract node instrumentation
  if type node; then
    set +e # best effort, a failing version must not stop the others
    rm -rf /usr/share/opentelemetry_shell/agent.instrumentation.node/*/
    archived="$(tar -I 'zstd -d --long=27' -tf /usr/share/opentelemetry_shell/agent.instrumentation.node/node_modules.tar.zst 2>/dev/null | cut -d / -f 2 | grep -E '^[0-9]+$' | sort -n -u)"
    if [ -n "$archived" ] && { type docker >/dev/null 2>&1 || [ "$GITHUB_ACTIONS" = true ]; }; then # containers may bring any version
      versions="$(seq "$(echo "$archived" | head -n 1)" "$(grep '^FROM ' /usr/share/opentelemetry_shell/agent.instrumentation.node/Dockerfile | cut -d : -f 2 | cut -d - -f 1)")"
    else
      versions="$(echo "$PATH" | tr : '\n' | while read -r d; do [ -x "$d"/node ] && "$d"/node --version; done | tr -d v | cut -d . -f 1 | sort -n -u)"
    fi
    for version in $versions; do
      lower="$(echo "$archived" | while read -r a; do [ "$a" -le "$version" ] && echo "$a"; done | tail -n 1)"
      if [ -n "$lower" ]; then # archived as this or a lower version (CI drops versions identical to the one below)
        [ -d /usr/share/opentelemetry_shell/agent.instrumentation.node/"$lower" ] || tar -I 'zstd -d --long=27' -xf /usr/share/opentelemetry_shell/agent.instrumentation.node/node_modules.tar.zst -C /usr/share/opentelemetry_shell/agent.instrumentation.node ./"$lower"
        [ "$lower" = "$version" ] || hardlink_or_copy /usr/share/opentelemetry_shell/agent.instrumentation.node/"$lower" /usr/share/opentelemetry_shell/agent.instrumentation.node/"$version"
      elif type npm; then # not archived, build it
        mkdir /usr/share/opentelemetry_shell/agent.instrumentation.node/"$version" && cp /usr/share/opentelemetry_shell/agent.instrumentation.node/package.json /usr/share/opentelemetry_shell/agent.instrumentation.node/"$version"/ && (cd /usr/share/opentelemetry_shell/agent.instrumentation.node/"$version" && npm install --no-audit --no-fund --no-package-lock) || rm -rf /usr/share/opentelemetry_shell/agent.instrumentation.node/"$version" # SKIP_DEPENDENCY_CHECK
      fi
    done
    for d in /usr/share/opentelemetry_shell/agent.instrumentation.node/*/; do cp /usr/share/opentelemetry_shell/agent.instrumentation.node/*.js "$d"; done
  fi 2>&1 | perl -0777 -pe '' >&2 &
  # extract python instrumentation
  if type python3; then
    set +e # best effort, a failing version must not stop the others
    rm -rf /usr/share/opentelemetry_shell/agent.instrumentation.python/*/
    listing="$(tar -I 'zstd -d --long=27' -tf /usr/share/opentelemetry_shell/agent.instrumentation.python/python_site_packages.tar.zst 2>/dev/null)"
    archived="$(echo "$listing" | cut -d / -f 2 | grep -E '^3\.[0-9]+$' | sort -t . -k 2 -n -u)"
    if [ -n "$archived" ] && { type docker >/dev/null 2>&1 || [ "$GITHUB_ACTIONS" = true ]; }; then # containers may bring any version
      versions="$(seq -f '3.%g' "$(echo "$archived" | head -n 1 | cut -d . -f 2)" "$(grep '^FROM ' /usr/share/opentelemetry_shell/agent.instrumentation.python/Dockerfile | cut -d : -f 2 | cut -d - -f 1 | cut -d . -f 2)")"
    else
      versions="$(echo "$PATH" | tr : '\n' | while read -r d; do ls "$d" 2>/dev/null; done | grep -E '^python3\.[0-9]+$' | cut -c 7- | sort -t . -k 2 -n -u)"
    fi
    for version in $versions; do
      lower="$(echo "$archived" | while read -r a; do [ "${a#3.}" -le "${version#3.}" ] && echo "$a"; done | tail -n 1)"
      if [ -n "$lower" ] && { [ "$lower" = "$version" ] || ! echo "$listing" | grep -q "^\./$lower/.*\.cpython-3${lower#3.}-.*\.so$"; }; then # archived as this or a lower version without native code (CI drops versions identical to the one below)
        [ -d /usr/share/opentelemetry_shell/agent.instrumentation.python/"$lower" ] || tar -I 'zstd -d --long=27' -xf /usr/share/opentelemetry_shell/agent.instrumentation.python/python_site_packages.tar.zst -C /usr/share/opentelemetry_shell/agent.instrumentation.python ./"$lower"
        [ "$lower" = "$version" ] || hardlink_or_copy /usr/share/opentelemetry_shell/agent.instrumentation.python/"$lower" /usr/share/opentelemetry_shell/agent.instrumentation.python/"$version"
      elif type python"$version"; then # not archived, build it
        venv="$(mktemp -u)"
        python"$version" -m venv "$venv" && my_pip "$venv"/bin/pip install --no-compile -r /usr/share/opentelemetry_shell/agent.instrumentation.python/requirements.txt && { ! [ -r /usr/share/opentelemetry_shell/agent.instrumentation.python/instrumentations_"$version".txt ] || my_pip "$venv"/bin/pip install --no-compile -r /usr/share/opentelemetry_shell/agent.instrumentation.python/instrumentations_"$version".txt; } && "$venv"/bin/pip uninstall --yes pip setuptools && mkdir /usr/share/opentelemetry_shell/agent.instrumentation.python/"$version" && mv "$venv"/lib/python"$version"/site-packages /usr/share/opentelemetry_shell/agent.instrumentation.python/"$version"/ || rm -rf /usr/share/opentelemetry_shell/agent.instrumentation.python/"$version"
        rm -rf "$venv"
      fi
      type python"$version" && python"$version" -m compileall -q -j 0 /usr/share/opentelemetry_shell/agent.instrumentation.python/"$version"/site-packages
    done
  fi 2>&1 | perl -0777 -pe '' >&2 &
  # init sdk venv
  if type uv 1>/dev/null 2>/dev/null; then
    uv venv /opt/opentelemetry_shell/venv && ( uv pip install --offline --python /opt/opentelemetry_shell/venv/bin/python3 -r /opt/opentelemetry_shell/requirements.txt || my_pip uv pip install --python /opt/opentelemetry_shell/venv/bin/python3 -r /opt/opentelemetry_shell/requirements.txt ) && uv pip check --python /opt/opentelemetry_shell/venv/bin/python3 # SKIP_DEPENDENCY_CHECK
  else
    python3 -m venv /opt/opentelemetry_shell/venv && . /opt/opentelemetry_shell/venv/bin/activate && my_pip pip3 install --no-compile -r /opt/opentelemetry_shell/requirements.txt && pip3 check && deactivate && (/opt/opentelemetry_shell/venv/bin/python3 -m compileall -q -j 0 /opt/opentelemetry_shell/venv || true) # SKIP_DEPENDENCY_CHECK
  fi
  # precompile sdk venv
  cat /usr/share/opentelemetry_shell/*.py | while read -r line; do printf '%s\n' "$line"; done | grep -E '^import |^from ' | /opt/opentelemetry_shell/venv/bin/python3 # venv may be used by different users that may not be allowed to create pyc files
  # wait for all background jobs
  wait
else
  exit 1
fi
